{
  "name": "MiniRay C++20 + Python 3.12",
  "image": "cpp-project-dev:2026-10-28-vscode-clangd",
  "workspaceFolder": "/workspaces/miniray",
  "remoteUser": "root",
  "containerEnv": {
    "VCPKG_ROOT": "/opt/vcpkg",
    "VCPKG_DEFAULT_TRIPLET": "x64-linux",
    "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
    "HTTP_PROXY": "http://127.0.0.1:7897",
    "HTTPS_PROXY": "http://127.0.0.1:7897",
    "ALL_PROXY": "http://127.0.0.1:7897",
    "NO_PROXY": "localhost,127.0.0.1,::1,mirrors.aliyun.com",
    "http_proxy": "http://127.0.0.1:7897",
    "https_proxy": "http://127.0.0.1:7897",
    "all_proxy": "http://127.0.0.1:7897",
    "no_proxy": "localhost,127.0.0.1,::1,mirrors.aliyun.com"
  },
  "mounts": [
    {
      "type": "volume",
      "source": "cpp-project-vcpkg-binary-cache",
      "target": "/root/.cache/vcpkg"
    }
  ],
  "runArgs": [
    "--network=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb",
        "twxs.cmake",
        "cschlosser.doxdocgen",
        "editorconfig.editorconfig",
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "meta.pyrefly",
        "mhutchie.git-graph",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
